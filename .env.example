# Copy to .env.local and fill in. Without these, the demo runs with its labelled fallback
# (structured mode on the example input only) and LLM Only mode reports that no LLM is configured.

# anthropic | openai
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Optional for anthropic (default claude-sonnet-5), required for openai
LLM_MODEL=
