# Copy to .env.local and fill in. Without these, the demo shows recorded (or prepared) answers
# for the prepared inputs, and LLM Only mode shows recorded answers where they exist.

# gemini | anthropic | openai
LLM_PROVIDER=gemini
LLM_API_KEY=
# Required for gemini and openai (check the current model id in the provider console).
# Optional for anthropic (default claude-sonnet-5).
LLM_MODEL=
